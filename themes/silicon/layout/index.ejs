<%
  const home = site.data.home || {};
  const hero = home.hero || {};
  const panel = home.panel || {};
  const sections = home.sections || {};
  const featuredCategories = home.featured_categories || theme.featured_categories || [];
  const quickLinks = home.quick_links || [];
  const heroButtons = hero.buttons || [];
  const currentPage = page.current || 1;
  const totalPages = page.total || 1;
  const paginationItems = [];
  const linkUrl = function(target) {
    if (!target) return url_for('/');
    return /^(https?:)?\/\//.test(target) ? target : url_for(target);
  };
  const pageLink = function(pageNumber) {
    if (pageNumber <= 1) return url_for('/');
    return url_for('/' + (config.pagination_dir || 'page') + '/' + pageNumber + '/');
  };

  if (totalPages <= 7) {
    for (let pageNumber = 1; pageNumber <= totalPages; pageNumber += 1) {
      paginationItems.push(pageNumber);
    }
  } else {
    let rangeStart = Math.max(2, currentPage - 2);
    let rangeEnd = Math.min(totalPages - 1, currentPage + 2);

    if (currentPage <= 4) rangeEnd = Math.min(6, totalPages - 1);
    if (currentPage >= totalPages - 3) rangeStart = Math.max(2, totalPages - 5);

    paginationItems.push(1);
    if (rangeStart > 2) paginationItems.push('ellipsis-start');
    for (let pageNumber = rangeStart; pageNumber <= rangeEnd; pageNumber += 1) {
      paginationItems.push(pageNumber);
    }
    if (rangeEnd < totalPages - 1) paginationItems.push('ellipsis-end');
    paginationItems.push(totalPages);
  }
%>

<section class="hero">
  <div class="hero-copy">
    <p class="eyebrow"><%= hero.eyebrow || 'Microelectronics · AI · Physics · Life' %></p>
    <h1><%= hero.title || config.title %></h1>
    <p class="hero-text"><%= hero.intro || config.description %></p>
    <div class="hero-actions">
      <% heroButtons.forEach(function(button) { %>
        <a class="button<%= button.primary ? ' primary' : '' %>" href="<%- linkUrl(button.url) %>"><%= button.text %></a>
      <% }) %>
    </div>
  </div>
  <div class="hero-panel">
    <span><%= panel.label || 'Learning Notes' %></span>
    <strong><%= panel.title || 'Semiconductors, Vision, Algorithms' %></strong>
    <p><%= panel.text || '把知识、项目和成长轨迹放在一个长期可维护的地方。' %></p>
  </div>
</section>

<section class="section-grid">
  <div class="section-main">
    <div class="section-heading">
      <h2><%= sections.recent_title || '最近文章' %></h2>
      <a href="<%- url_for('/archives/') %>"><%= sections.archive_link || '全部归档' %></a>
    </div>
    <div class="post-list">
      <% page.posts.forEach(function(post) { %>
        <article class="post-item">
          <div class="post-card-meta">
            <time datetime="<%= date_xml(post.date) %>"><%= date(post.date, 'YYYY-MM-DD') %></time>
            <span class="post-card-views">点击量 <span data-post-view-counter data-counter-path="<%- url_for(post.path) %>">--</span></span>
          </div>
          <h3><a href="<%- url_for(post.path) %>"><%= post.title %></a></h3>
          <% if (post.excerpt) { %><p><%- strip_html(post.excerpt).substring(0, 120) %></p><% } %>
        </article>
      <% }) %>
    </div>
    <% if (totalPages > 1) { %>
      <nav class="pagination" aria-label="文章分页">
        <% if (currentPage > 1) { %>
          <a class="pagination-button pagination-direction" href="<%- pageLink(currentPage - 1) %>" rel="prev">上页</a>
        <% } else { %>
          <span class="pagination-button pagination-direction is-disabled" aria-disabled="true">上页</span>
        <% } %>

        <div class="pagination-pages">
          <% paginationItems.forEach(function(item) { %>
            <% if (typeof item === 'number') { %>
              <% if (item === currentPage) { %>
                <span class="pagination-button is-current" aria-current="page"><%= item %></span>
              <% } else { %>
                <a class="pagination-button" href="<%- pageLink(item) %>" aria-label="第 <%= item %> 页"><%= item %></a>
              <% } %>
            <% } else { %>
              <span class="pagination-ellipsis" aria-hidden="true">…</span>
            <% } %>
          <% }) %>
        </div>

        <% if (currentPage < totalPages) { %>
          <a class="pagination-button pagination-direction" href="<%- pageLink(currentPage + 1) %>" rel="next">下页</a>
        <% } else { %>
          <span class="pagination-button pagination-direction is-disabled" aria-disabled="true">下页</span>
        <% } %>

        <form class="pagination-jump" data-pagination-jump data-base-url="<%- url_for('/') %>" data-page-dir="<%= config.pagination_dir || 'page' %>" data-total-pages="<%= totalPages %>">
          <label>
            第
            <input type="number" min="1" max="<%= totalPages %>" value="<%= currentPage %>" inputmode="numeric" aria-label="要跳转的页码">
            / <%= totalPages %> 页
          </label>
          <button type="submit">跳转</button>
        </form>
      </nav>
    <% } %>
  </div>
  <aside class="section-side">
    <h2><%= sections.featured_title || '精选分类' %></h2>
    <div class="category-cloud">
      <% featuredCategories.forEach(function(name) { %>
        <a href="<%- url_for('/categories/' + name + '/') %>"><%= name %></a>
      <% }) %>
    </div>
  </aside>
</section>

<section class="quick-links">
  <% quickLinks.forEach(function(item) { %>
    <a href="<%- linkUrl(item.url) %>">
      <span><%= item.label %></span>
      <strong><%= item.text %></strong>
    </a>
  <% }) %>
</section>
